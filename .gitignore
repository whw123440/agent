# 虚拟环境
.venv/
venv/
ENV/
env/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints
*.ipynb.bak

# Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 数据文件（大文件不提交）
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.xlsx
*.h5
*.parquet
*.db

# 模型文件
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.pth
!models/.gitkeep

# 日志和报告
reports/logs/*
reports/metrics/*
!reports/logs/.gitkeep
!reports/metrics/.gitkeep
*.log

# 图表输出（可选择性提交）
reports/figures/*.png
reports/figures/*.pdf
reports/figures/*.svg
!reports/figures/.gitkeep

# 环境变量
.env
.venv/

# IDE配置
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db

# 配置文件（如果包含敏感信息）
config/config.local.yaml

# 测试覆盖率
.coverage
htmlcov/
.pytest_cache/

# 临时文件
tmp/
temp/
*.tmp
*.bak

# 打包文件
*.egg-info/
dist/
build/